rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Hjælpefunktioner ────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isTrainerOrAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'trainer'];
    }

    // ── Brugerprofiler ───────────────────────────────────────────────────────
    // Brugere kan læse og opdatere deres egen profil.
    // Admin kan læse/skrive alle profiler.
    //
    // SIKKERHED: 'role' styrer adgang til admin-API'er (bl.a. send-sms.php) og
    // til isAdmin()/isTrainerOrAdmin() i resten af disse regler. En almindelig
    // bruger må derfor ALDRIG kunne sætte sin egen role til 'admin' — ellers
    // kan enhver signeret bruger forfremme sig selv til admin direkte via
    // Firestore-klienten og dermed udsende SMS til hele klubben m.m.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      // Ny profil oprettes altid med standard-rollen 'Medlem'.
      allow create: if isOwner(uid) && request.resource.data.role == 'Medlem';

      // Egen profil må opdateres, men:
      //  - aldrig hvis den nuværende role allerede er 'admin' (kun admin selv kan ændre den)
      //  - den nye role skal enten være uændret, eller 'Medlem'/'trainer'
      //    (aldrig 'admin') — trainer-status synkes klientside ud fra
      //    members.lederHolds, som kun admin/service-account kan skrive.
      allow update: if isAdmin()
        || (isOwner(uid)
            && resource.data.role != 'admin'
            && (request.resource.data.role == resource.data.role
                || request.resource.data.role in ['Medlem', 'trainer']));

      allow delete: if isAdmin();
    }

    // ── Hold ─────────────────────────────────────────────────────────────────
    // Alle indloggede kan læse hold. Kun admin/træner kan skrive.
    match /holds/{holdId} {
      allow read:  if isSignedIn();
      allow write: if isTrainerOrAdmin();
    }

    // ── Medlemmer (synkroniseret fra Conventus) ───────────────────────────────
    // Alle indloggede kan læse. Kun admin kan skrive (via sync).
    match /members/{memberId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Beskeder ─────────────────────────────────────────────────────────────
    // Alle indloggede kan læse beskeder til deres hold.
    // Trænere og admin kan oprette og slette.
    match /messages/{msgId} {
      allow read:   if isSignedIn();
      allow create: if isTrainerOrAdmin();
      allow update: if isSignedIn(); // reaktioner
      allow delete: if isTrainerOrAdmin();
    }

    // ── Nyheder ──────────────────────────────────────────────────────────────
    match /news/{newsId} {
      allow read:  if isSignedIn();
      allow write: if isTrainerOrAdmin();
    }

    // ── Events / kalender ────────────────────────────────────────────────────
    match /events/{eventId} {
      allow read:   if isSignedIn();
      allow create: if isTrainerOrAdmin();
      allow update: if isTrainerOrAdmin();
      allow delete: if isTrainerOrAdmin();
    }

    // ── Banners ──────────────────────────────────────────────────────────────
    match /banners/{bannerId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // ── App-indstillinger ────────────────────────────────────────────────────
    match /settings/{settingId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Support / FAQ ────────────────────────────────────────────────────────
    // Alle indloggede kan oprette spørgsmål. Kun admin kan besvare/slette.
    match /support/{supportId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Pending Conventus-sessions ───────────────────────────────────────────
    // Skrives af server (PHP/service account). Læses af alle — tokenet er hemmeligt nok.
    match /conventus_pending/{token} {
      allow read:  if true;
      allow write: if false; // kun via service account (PHP)
    }

    // ── Infoskærme ───────────────────────────────────────────────────────────
    // Konfiguration af infoskærme (navn, mode, templates, holdIds, duration).
    // Infoskærme-player logger ind anonymt og kan dermed læse konfigurationen.
    // Kun admin kan oprette/redigere/slette skærme.
    match /infoscreens/{screenId} {
      allow read:   if isSignedIn(); // anonym auth er tilstrækkeligt
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Billedbibliotek (infoskærm-uploads) ─────────────────────────────────
    // Admin og trænere kan uploade og læse billeder. Kun admin kan slette.
    match /media_library/{imgId} {
      allow read:   if isTrainerOrAdmin();
      allow create: if isTrainerOrAdmin();
      allow delete: if isAdmin();
    }

    // ── Kommunikations-log (SMS/email-udsendelser) ───────────────────────────
    // Skrives udelukkende af send-sms.php / send-bulk-email.php via
    // service account (bypasser disse regler). Kun admin kan læse i backoffice.
    // Indeholder ALDRIG telefonnumre eller andre personnumre.
    match /kommunikation_logs/{logId} {
      allow read:  if isAdmin();
      allow write: if false;
    }
  }
}
